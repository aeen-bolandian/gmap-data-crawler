# ============================================
# Python bytecode & cache
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

# ============================================
# Virtual environments
# ============================================
venv/
.venv/
env/
ENV/

# ============================================
# IDE / Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# SECURITY: Local databases (NEVER commit)
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
data/*.db
data/*.sqlite3
*.db-wal
*.db-shm

# ============================================
# SECURITY: Crawler state & raw data
# ============================================
crawler_state.json
*.state.json
*.checkpoint
logs/
*.log

# ============================================
# SECURITY: Output datasets (raw reviews)
# ============================================
data/google_reviews.csv
data/*.csv
!data/samples/*.csv
!data/samples/*.json

# ============================================
# Environment variables & secrets
# ============================================
.env
.env.*
*.pem
*.key
secrets.json

# ============================================
# Playwright / OS artifacts
# ============================================
.playwright/
.DS_Store
Thumbs.db
desktop.ini